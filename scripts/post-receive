#!/usr/bin/env bash
set -e

WORK_TREE="/opt/nyxframework"
GIT_DIR="/var/repo/nyxframework.git"
RESOURCES_DIR="/opt/fivem/server-data/resources/[nyx]"
SERVER_CFG="/opt/fivem/server-data/server.cfg"
LOG_FILE="/var/log/nyx-git-deploy.log"

echo "================================================================" | tee -a "$LOG_FILE"
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Proxmox FiveM Continuous Deploy Triggered" | tee -a "$LOG_FILE"
echo "================================================================" | tee -a "$LOG_FILE"

while read oldrev newrev refname; do
    branch=$(git rev-parse --symbolic --abbrev-ref "$refname" 2>/dev/null) || branch="$refname"
    echo "[*] Received push on ref: $refname (branch: $branch)" | tee -a "$LOG_FILE"
    echo "[*] Target commit: $newrev" | tee -a "$LOG_FILE"

    # 1. Checkout repository into /opt/nyxframework
    echo "[*] Checking out $branch into $WORK_TREE..." | tee -a "$LOG_FILE"
    mkdir -p "$WORK_TREE"
    git --work-tree="$WORK_TREE" --git-dir="$GIT_DIR" checkout -f "$newrev"

    # 2. Sync FiveM resources into /opt/fivem/server-data/resources/[nyx]
    echo "[*] Synchronizing resources to $RESOURCES_DIR..." | tee -a "$LOG_FILE"
    mkdir -p "$RESOURCES_DIR"
    rsync -av --delete \
        --exclude 'server.cfg' \
        --exclude 'server.cfg.example' \
        --exclude 'bootstrap_check.*' \
        --exclude 'scripts' \
        --exclude '__pycache__' \
        "$WORK_TREE/FiveM/" "$RESOURCES_DIR/" | tee -a "$LOG_FILE"

    # 3. Ensure permissions
    chmod -R 755 "$RESOURCES_DIR"

    # 4. Ensure nyx_press is declared in server.cfg
    if ! grep -q "ensure nyx_press" "$SERVER_CFG"; then
        echo "[*] Appending 'ensure nyx_press' to $SERVER_CFG" | tee -a "$LOG_FILE"
        echo "" >> "$SERVER_CFG"
        echo "# 10. Media, Public Communications and Press" >> "$SERVER_CFG"
        echo "ensure nyx_press" >> "$SERVER_CFG"
    fi

    # 5. Execute in-engine repository validator on server
    echo "[*] Validating updated repository integrity inside container..." | tee -a "$LOG_FILE"
    if python3 "$WORK_TREE/scripts/validator.py" >> "$LOG_FILE" 2>&1; then
        echo "[+] Validator passed cleanly!" | tee -a "$LOG_FILE"
    else
        echo "[!] Warning: Validator reported issues. Check $LOG_FILE" | tee -a "$LOG_FILE"
    fi

    # 6. Gracefully restart fivem service to execute migrations & load new resources
    echo "[*] Restarting fivem.service to apply migrations and reload modules..." | tee -a "$LOG_FILE"
    systemctl restart fivem.service
    sleep 2
    if systemctl is-active --quiet fivem.service; then
        echo "[+] fivem.service is active and healthy!" | tee -a "$LOG_FILE"
    else
        echo "[!] Warning: fivem.service status check failed." | tee -a "$LOG_FILE"
        systemctl status fivem.service --no-pager | tee -a "$LOG_FILE"
    fi

    echo "[$(date +'%Y-%m-%d %H:%M:%S')] Deployment of commit $newrev completed successfully!" | tee -a "$LOG_FILE"
done

echo "================================================================" | tee -a "$LOG_FILE"
